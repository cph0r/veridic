{
  "name": "veridic",
  "version": "0.14.0",
  "description": "Turn your app into specs, kept true by the code. Every rule points at the code that does it and is proven by your tests, a blueprint dashboard shows it all, and your coding agent can't call a change done until it's in scope and tested. Claude Code plugin + CLI for Express apps.",
  "type": "module",
  "bin": {
    "veridic": "bin/veridic"
  },
  "exports": {
    "./package.json": "./package.json",
    "./graph": {
      "types": "./types/graph.d.ts",
      "default": "./core/graph.mjs"
    },
    "./indexer": {
      "types": "./types/indexer.d.ts",
      "default": "./core/indexer.mjs"
    },
    "./staleness": {
      "types": "./types/staleness.d.ts",
      "default": "./core/staleness.mjs"
    },
    "./citations": {
      "types": "./types/citations.d.ts",
      "default": "./core/citations.mjs"
    },
    "./basis": {
      "types": "./types/basis.d.ts",
      "default": "./core/basis.mjs"
    },
    "./anchors": {
      "types": "./types/anchors.d.ts",
      "default": "./core/anchors.mjs"
    },
    "./tokens": {
      "types": "./types/tokens.d.ts",
      "default": "./core/tokens.mjs"
    },
    "./product": {
      "types": "./types/product.d.ts",
      "default": "./core/product.mjs"
    }
  },
  "files": [
    "bin/",
    "core/",
    "skill/",
    "commands/",
    "agents/",
    "hooks/",
    ".claude-plugin/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "PRIVACY.md",
    "types/"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@colbymchenry/codegraph": "1.6.0"
  },
  "scripts": {
    "test": "VERIDIC_NO_SYNC=1 node --test \"test/*.test.mjs\""
  },
  "keywords": [
    "spec-driven-development",
    "specs",
    "traceability",
    "evidence",
    "code-review",
    "agent-readiness",
    "claude-code",
    "claude-code-plugin",
    "codegraph",
    "express",
    "nextjs"
  ],
  "author": "Chirag Phor (https://github.com/cph0r)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cph0r/veridic.git"
  },
  "homepage": "https://github.com/cph0r/veridic#readme",
  "bugs": {
    "url": "https://github.com/cph0r/veridic/issues"
  }
}
