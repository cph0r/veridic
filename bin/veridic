#!/usr/bin/env node
// veridic CLI. On the Bash tool's PATH while the plugin is enabled, so Claude
// (or anyone) runs `veridic metrics` from inside a repo. --repo defaults to the
// current git repository.

import { spawnSync, execFileSync } from "node:child_process";
import fs from "node:fs";
import path from "node:path";

const root = path.resolve(path.dirname(fs.realpathSync(process.argv[1])), "..");
const COMMANDS = {
  report: ["skill/scripts/report.mjs", "open the report in your browser: your specs, each rule proven, broken or out of date (--json for the data)"],
  ui: ["skill/scripts/report.mjs", "same as report"],
  init: ["skill/scripts/init.mjs", "set a repo up: find codegraph (--install to install it), build or update the code index, check routes"],
  metrics: ["skill/scripts/metrics.mjs", "every number in one call (--md for a table)"],
  check: [null, "cite + claims: are the citations right?"],
  routes: ["skill/scripts/routes.mjs", "list the app's routes, filtered by words (to pick seeds)"],
  scope: ["skill/scripts/scope.mjs", "what belongs to a feature, and what to read"],
  read: ["skill/scripts/read.mjs", "print all the code to read for a feature in one call"],
  coverage: ["skill/scripts/coverage.mjs", "how much of the app the specs describe: every behaviour file and the spec that cites it (--module <id>, --md)"],
  parts: ["skill/scripts/modules.mjs", "the parts of the app (same as modules): each part's spec files and where to write its one spec (--md for a table)"],
  modules: ["skill/scripts/modules.mjs", "the app's parts as Veridic found them: routes, state, each part's spec and where to write it (--md for a table)"],
  prepare: ["skill/scripts/prepare.mjs", "scope + contract + code for a feature as one document (to start a session with); --module <id> for a whole part with its full context"],
  conform: ["skill/scripts/conform.mjs", "run the conformance suite from the specs against a running app (--url, local only unless --allow-remote): access, scope, examples, journeys; a fidelity %"],
  environment: ["skill/scripts/environment.mjs", "the environment the app needs: env vars (required, defaults), services, schedules, deployment; names only (--write: specs/environment/spec.md, --md)"],
  drift: ["skill/scripts/drift.mjs", "where the OpenAPI contract and the code disagree"],
  states: ["skill/scripts/states.mjs", "the feature's state machine and bug-shaped patterns in it"],
  access: ["skill/scripts/access.mjs", "who can call each route, plan checks, caller scoping (--intended <csv> to compare)"],
  "agent-ready": ["skill/scripts/agent-ready.mjs", "is this API safe for AI agents: real effect per route (read/write/destructive, money, notifies), GETs that write, unscoped money routes (--manifest for the tool manifest)"],
  render: ["skill/scripts/render.mjs", "spec.json -> spec.md + traceability.md (validates first)"],
  cite: ["skill/scripts/cite.mjs", "do citations resolve; the text they point at"],
  claims: ["skill/scripts/claims.mjs", "do cited lines hold the facts each rule states"],
  anchor: ["skill/scripts/anchor.mjs", "add symbol anchors so citations survive code moving"],
  stale: ["skill/scripts/stale.mjs", "rules a change touched (--fix, --pr)"],
  impact: ["skill/scripts/impact.mjs", "before an edit: every route a file, range or route reaches, what each really does, and which tests cover it (--card)"],
  claim: ["skill/scripts/claim.mjs", "before an edit: record the routes or files this task will change; `done` then checks the change against it"],
  done: ["skill/scripts/done.mjs", "is it done: the change stayed in the claimed rules' seam, and each criterion has an asserting (passing, with --run) test (--card). Without --spec: claim routes or files"],
  why: ["skill/scripts/why.mjs", "the commits behind a rule's cited lines, as decision evidence"],
  mutate: ["skill/scripts/mutate.mjs", "would the guard notice the code behind a rule changing"],
  tests: ["skill/scripts/tests.mjs", "which rules have a named test that reaches their code (--run: pass/fail); --module <id>: the work list for turning a part's rules into tests; --link ID=file:line …: name existing tests for rules"],
  scaffold: ["skill/scripts/scaffold.mjs", "test skeleton: one placeholder per rule, named with its id"],
  "install-hook": ["skill/hooks/install.mjs", "install the git pre-commit hook in a repo"],
};

const [cmd, ...rest] = process.argv.slice(2);
if (!cmd || cmd === "help" || cmd === "--help" || !COMMANDS[cmd]) {
  const width = Math.max(...Object.keys(COMMANDS).map((k) => k.length));
  process.stdout.write(
    `veridic <command> [--repo <path>] [options]\n\n${Object.entries(COMMANDS)
      .map(([k, [, d]]) => `  ${k.padEnd(width)}  ${d}`)
      .join("\n")}\n\nEach prints JSON and exits 0 (ok), 1 (problems found) or 2 (usage error).\n`,
  );
  process.exit(cmd && cmd !== "help" && cmd !== "--help" ? 2 : 0);
}

const args = [...rest];
if (!args.includes("--repo")) {
  let repo = process.cwd();
  try {
    repo = execFileSync("git", ["rev-parse", "--show-toplevel"], { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim();
  } catch {}
  args.push("--repo", repo);
}

const runScript = (rel, a) => spawnSync(process.execPath, [path.join(root, rel), ...a], { stdio: "inherit" }).status ?? 2;

if (cmd === "check") {
  // Two checks, one exit code: citations resolve, and cited lines hold the stated facts.
  const a = runScript("skill/scripts/cite.mjs", args);
  const b = runScript("skill/scripts/claims.mjs", args);
  process.exit(Math.max(a, b));
}
process.exit(runScript(COMMANDS[cmd][0], args));
